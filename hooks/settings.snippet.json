{
  "statusLine": {
    "type": "command",
    "command": "python3 __REPO__/hooks/forward.py --event StatusLine --print"
  },
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3 __REPO__/hooks/forward.py", "timeout": 5}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3 __REPO__/hooks/forward.py", "timeout": 5}]}
    ],
    "PreToolUse": [
      {"hooks": [{"type": "command", "command": "python3 __REPO__/hooks/forward.py", "timeout": 5}]}
    ],
    "Notification": [
      {"hooks": [{"type": "command", "command": "python3 __REPO__/hooks/forward.py", "timeout": 5}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 __REPO__/hooks/forward.py", "timeout": 5}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "python3 __REPO__/hooks/forward.py", "timeout": 5}]}
    ]
  }
}
